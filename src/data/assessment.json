            { "value": 1, "text": "No strategy exists" },
            { "value": 2, "text": "Basic strategy being developed" },
            { "value": 3, "text": "Strategy exists but not well communicated" },
            { "value": 4, "text": "Well-defined strategy with clear roadmap" },
            { "value": 5, "text": "Comprehensive strategy with regular reviews and updates" }
          ]
